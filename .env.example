# Copia este fichero como .env (instalar.ps1 / instalar.sh lo hacen) o rellénalo desde la interfaz:
# «Configuración → Conexiones». El .env nunca se sube a git.

# La SEC exige identificarse en cada petición (gratis): "Nombre email@dominio.com"
EDGAR_IDENTITY=

# Modelo de lenguaje (opcional; docs/ia.md): Gemini > llama4 en OpenRouter > gpt-oss-120b en Groq > Ollama local.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# LLM_PROVIDER=groq

# Carpeta de datos (base de datos, cachés, PDFs y registro). Por defecto, la del usuario, fuera de OneDrive.
# INFORMES_DATA_DIR=C:\informes-warrants-datos
