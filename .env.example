# La SEC exige identificarse en cada petición: "Nombre email@dominio.com"
EDGAR_IDENTITY="Nombre Apellido tu@email.com"

# Modelo de lenguaje (docs/ia.md): llama4 en OpenRouter > gpt-oss-120b en Groq > Ollama local.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b

# Carpeta de datos (base de datos, snapshots, PDFs). Por defecto, la del usuario, fuera de OneDrive.
# INFORMES_DATA_DIR=C:\informes-warrants-datos
