      <h3>Datos de mercado</h3>
      <table class="datos lateral-tabla">
        <tr><td>Cotización (USD)</td><td>{{ c.cotizacion.precio|num(2) }}</td></tr>
        <tr><td>Capitalización (USD bn)</td><td>{{ (c.multiplos.capitalizacion/1e9)|num(1) }}</td></tr>
        {% if c.multiplos.get("ev") is not none %}<tr><td>Valor de empresa, EV (USD bn)</td><td>{{ (c.multiplos.ev/1e9)|num(1) }}</td></tr>{% endif %}
        <tr><td>Acciones en circulación (mn)</td><td>{{ (c.mercado.acciones/1e6)|num(0) }}</td></tr>
        <tr><td>Máx. / medio / mín. 12m</td><td>{{ c.cotizacion.maximo_12m|num(0) }} / {{ c.cotizacion.medio_12m|num(0) }} / {{ c.cotizacion.minimo_12m|num(0) }}</td></tr>
        <tr><td>Volumen medio diario (USD mn)</td><td>{{ (c.cotizacion.volumen_medio_12m/1e6)|num(0) }}</td></tr>
        {% if c.cotizacion.volumen_medio_acciones_12m %}<tr><td>Volumen medio diario (mn acciones)</td><td>{{ (c.cotizacion.volumen_medio_acciones_12m/1e6)|num(1) }}</td></tr>{% endif %}
        <tr><td>Valor contable por acción (USD)</td><td>{{ c.valor_contable_por_accion|num(2) }}</td></tr>
        {% if c.capital_flotante %}<tr><td>Capital flotante (USD bn, {{ c.capital_flotante[1] }})</td><td>{{ (c.capital_flotante[0]/1e9)|num(1) }}</td></tr>{% endif %}
        <tr><td>Beta (5a, semanal vs SPY)</td><td>{{ c.beta|num(2) }}</td></tr>
        {% set fi = c.get("ficha") or {} %}{% if fi.get("bolsa") %}<tr><td>Bolsa</td><td>{{ fi.bolsa }}</td></tr>{% endif %}
        {% if fi.get("cierre_fiscal") %}<tr><td>Cierre del ejercicio fiscal</td><td>{{ fi.cierre_fiscal }}</td></tr>{% endif %}
        <tr><td>Empleados (10-K)</td><td>{{ fi.empleados.numero|num(0) if fi.get("empleados") else "n.d." }}</td></tr>
      </table>

