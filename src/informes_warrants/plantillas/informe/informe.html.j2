<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ c.empresa }} ({{ c.ticker }}) · Warrants & Co.</title>
<link rel="stylesheet" href="estilo.css">
</head>
<body>
<span class="cabecera-dato">{{ c.empresa }} ({{ c.ticker }}) · {{ fecha_larga }}</span>

<!-- ============ 1. PORTADA ============ -->
<section class="portada">
  <div class="masthead">
    <div class="marca"><img class="logo" src="../marca/logo.svg"><img class="nombre" src="../marca/nombre.svg"></div>
    <div class="tipo">Apertura de posición · Renta variable EEUU<span>{{ fecha_larga }} · Cotización a {{ c.cotizacion.fecha }}</span></div>
  </div>

  <div class="titulo">
    <h1>{{ c.empresa }}</h1>
    <div class="sub"><strong>{{ c.ticker }}</strong> · SIC {{ c.sic }} · Índice sectorial {{ c.etf }} · Último 10-K: FY{{ c.filing.ejercicio }} ({{ c.filing.fecha }})</div>
  </div>

  <div class="rejilla">
    <div class="principal">
      <h3>Tesis de inversión</h3>
      {{ t["portada.titulares"] }}
      {{ t["portada.recomendacion"] }}
      <div class="kpis">
        <div class="kpi"><div class="v">{{ (fl.ingresos/1e9)|num(1) }}</div><div class="l">Ingresos {{ etiqueta_ltm }} (USD bn)</div></div>
        <div class="kpi"><div class="v">{{ fl.margen_operativo|pct }}</div><div class="l">Margen operativo {{ etiqueta_ltm }}</div></div>
        <div class="kpi"><div class="v">{{ fl.roic|pct }}</div><div class="l">ROIC {{ etiqueta_ltm }}</div></div>
        <div class="kpi"><div class="v">{{ fl.conversion_fcf|pct(0) }}</div><div class="l">Conversión de FCF</div></div>
      </div>
      <h3>Situación actual</h3>
      {{ t["conclusiones.situacion"] }}
      <h3>Comportamiento bursátil (base 100, 5 años)</h3>
      <div class="grafico" style="width:100%">{{ g.base_100 }}</div>
      <div class="fuente">Fuente: yfinance (cierres ajustados). {{ c.ticker }} frente a S&amp;P 500 (SPY) y a su índice sectorial ({{ c.etf }}).</div>
    </div>

    <div class="lateral">
      <div class="recomendacion">
        <div class="etiqueta">Recomendación</div>
        <div class="valor">{{ c.recomendacion }}</div>
        <table>
          <tr><td>Precio objetivo{% if c.estimaciones.precio_objetivo_analista %} (analista){% endif %}</td><td class="n">{{ c.precio_objetivo|num(2) }} USD</td></tr>
          {% if c.estimaciones.precio_objetivo_analista %}<tr><td>Precio objetivo del modelo</td><td class="n">{{ c.precio_modelo|num(2) }} USD</td></tr>{% endif %}
          {% if c.valor_dcf is not none %}<tr><td>Valor DCF (escenarios)</td><td class="n">{{ c.valor_dcf|num(2) }} USD</td></tr>{% endif %}
          {% if c.valor_multiplos is not none %}<tr><td>Valor por múltiplos</td><td class="n">{{ c.valor_multiplos|num(2) }} USD</td></tr>{% endif %}
          <tr><td>Cotización</td><td class="n">{{ c.cotizacion.precio|num(2) }} USD</td></tr>
          <tr><td>Potencial</td><td class="n">{{ c.potencial|var }}</td></tr>
          {% if c.rango_dcf[0] is not none %}<tr><td>Rango (pesimista – optimista)</td><td class="n">{{ c.rango_dcf[0]|num(0) }} – {{ c.rango_dcf[1]|num(0) }} USD</td></tr>{% endif %}
        </table>
      </div>
      <h3>Datos de mercado</h3>
      <table class="datos lateral-tabla">
        <tr><td>Cotización (USD)</td><td>{{ c.cotizacion.precio|num(2) }}</td></tr>
        <tr><td>Capitalización (USD bn)</td><td>{{ (c.multiplos.capitalizacion/1e9)|num(1) }}</td></tr>
        <tr><td>Valor de empresa, EV (USD bn)</td><td>{{ (c.multiplos.ev/1e9)|num(1) }}</td></tr>
        <tr><td>Acciones en circulación (mn)</td><td>{{ (c.mercado.acciones/1e6)|num(0) }}</td></tr>
        <tr><td>Máx. / medio / mín. 12m</td><td>{{ c.cotizacion.maximo_12m|num(0) }} / {{ c.cotizacion.medio_12m|num(0) }} / {{ c.cotizacion.minimo_12m|num(0) }}</td></tr>
        <tr><td>Volumen medio diario (USD mn)</td><td>{{ (c.cotizacion.volumen_medio_12m/1e6)|num(0) }}</td></tr>
        {% if c.cotizacion.volumen_medio_acciones_12m %}<tr><td>Volumen medio diario (mn acciones)</td><td>{{ (c.cotizacion.volumen_medio_acciones_12m/1e6)|num(1) }}</td></tr>{% endif %}
        <tr><td>Valor contable por acción (USD)</td><td>{{ c.valor_contable_por_accion|num(2) }}</td></tr>
        {% if c.capital_flotante %}<tr><td>Capital flotante (USD bn, {{ c.capital_flotante[1] }})</td><td>{{ (c.capital_flotante[0]/1e9)|num(1) }}</td></tr>{% endif %}
        <tr><td>Beta (5a, semanal vs SPY)</td><td>{{ c.beta|num(2) }}</td></tr>
      </table>

      <h3>Datos financieros (USD mn)</h3>
      <table class="datos">
        <tr><th></th>{% for a in resumen_cabecera %}<th>{{ a }}</th>{% endfor %}{% for a in estimados_portada %}<th class="e">{{ a }}</th>{% endfor %}</tr>
        {% for fila in resumen %}<tr><td>{{ fila.nombre }}</td>{% for v in fila.valores %}<td{% if loop.index > 3 %} class="e"{% endif %}>{{ v }}</td>{% endfor %}</tr>{% endfor %}
      </table>
      {% if ns_portada %}<div class="fuente">n.s.: no significativo (crecimiento de 1.000 % o más, desde una base casi nula).</div>{% endif %}

      <h3>Múltiplos ({{ etiqueta_ltm }})</h3>
      <table class="datos lateral-tabla">
        <tr><td>PER</td><td>{{ c.multiplos.per|num(1) }}x</td></tr>
        <tr><td>EV / Ventas</td><td>{{ c.multiplos.ev_ventas|num(1) }}x</td></tr>
        <tr><td>EV / EBITDA</td><td>{{ c.multiplos.ev_ebitda|num(1) }}x</td></tr>
        <tr><td>EV / EBIT</td><td>{{ c.multiplos.ev_ebit|num(1) }}x</td></tr>
        <tr><td>P / FCF (tras SBC)</td><td>{{ c.multiplos.p_fcf|num(1) }}x</td></tr>
        <tr><td>P / Valor contable</td><td>{{ c.multiplos.p_bv|num(1) }}x</td></tr>
        <tr><td>Rentabilidad FCF (tras SBC)</td><td>{{ c.multiplos.fcf_yield|pct }}</td></tr>
        <tr><td>Rentabilidad por dividendo</td><td>{{ c.multiplos.rentabilidad_dividendo|pct }}</td></tr>
      </table>

      <h3>Comportamiento en bolsa</h3>
      <table class="datos">
        <tr><th></th>{% for h in horizontes %}<th>{{ h }}</th>{% endfor %}</tr>
        {% for nombre, fila in c.comportamiento.items() %}<tr><td>{{ etiquetas_comportamiento[nombre] }}</td>{% for h in claves_horizonte %}<td>{{ fila[h]|pct }}</td>{% endfor %}</tr>{% endfor %}
      </table>
      <div class="fuente">Relativo: diferencia en puntos porcentuales.</div>
      {% if c.autoria and c.autoria.rellena %}<h3>Autoría</h3>
      <table class="datos lateral-tabla">
        {% if c.autoria.analista %}<tr><td>Analista</td><td>{{ c.autoria.analista }}</td></tr>{% endif %}
        {% if c.autoria.correo %}<tr><td>Correo</td><td>{{ c.autoria.correo }}</td></tr>{% endif %}
        {% if c.autoria.telefono %}<tr><td>Teléfono</td><td>{{ c.autoria.telefono }}</td></tr>{% endif %}
        {% if c.autoria.empresa %}<tr><td>Entidad</td><td>{{ c.autoria.empresa }}</td></tr>{% endif %}
        {% if c.autoria.contacto_empresa %}<tr><td>Contacto</td><td>{{ c.autoria.contacto_empresa }}</td></tr>{% endif %}
      </table>{% endif %}
    </div>
  </div>
</section>

<!-- ============ 2. CONCLUSIONES, NEGOCIO Y GOBIERNO ============ -->
<section class="salto">
  <h2><span class="num">01</span>Conclusiones</h2>
  <h3>Hechos clave</h3>
  {{ t["conclusiones.hechos_clave"] }}
  <h3>Perspectivas</h3>
  {{ t["conclusiones.perspectivas"] }}
  {{ t["conclusiones.fortalezas_riesgos"] }}

  <h2><span class="num">02</span>Descripción del negocio</h2>
  {{ t["negocio.descripcion"] }}
  {% for s in segmentos %}
  <div style="break-inside: avoid">
  <h3>{{ s.titulo }} (USD mn)</h3>
  <table class="datos">
    <tr><th></th>{% for a in s.ejercicios %}<th>FY{{ a }}</th>{% endfor %}{% if s.ltm %}<th>{{ etiqueta_ltm }}*</th>{% endif %}<th>Peso FY{{ s.ejercicios[-1] }}</th></tr>
    {% for fila in s.filas %}<tr><td>{{ fila.nombre }}</td>{% for v in fila.valores %}<td>{{ v }}</td>{% endfor %}{% if s.ltm %}<td>{{ fila.ltm }}</td>{% endif %}<td>{{ fila.peso }}</td></tr>{% endfor %}
    <tr class="total"><td>Total (= ingresos consolidados)</td>{% for v in s.total %}<td>{{ v }}</td>{% endfor %}{% if s.ltm %}<td>{{ s.total_ltm }}</td>{% endif %}<td>100 %</td></tr>
    {% if s.resultado %}<tr class="seccion"><td colspan="{{ s.ejercicios|length + 2 + (1 if s.ltm else 0) }}">Resultado operativo por segmento (margen del último ejercicio)</td></tr>
    {% for fila in s.resultado %}<tr><td>{{ fila.nombre }}</td>{% for v in fila.valores %}<td>{{ v }}</td>{% endfor %}{% if s.ltm %}<td>—</td>{% endif %}<td>{{ fila.margen }}</td></tr>{% endfor %}{% endif %}
  </table>
  <div class="fuente">XBRL de los 10-K ({{ s.origen }}). Solo los ejercicios en que los miembros declarados suman los ingresos consolidados; los subtotales que la empresa también declara no se cuentan dos veces.{% if s.rechazados %} Sin desglose en {{ s.rechazados }}: los miembros declarados no suman el total.{% endif %}{% if s.ltm %} *{{ etiqueta_ltm }} provisional: la empresa no publica el LTM por segmento; se calcula como último ejercicio + acumulado del año − acumulado del año anterior (10-Q {{ s.ltm_origen }}) y cuadra con los ingresos LTM consolidados.{% endif %}</div>
  </div>
  {% endfor %}
  {% if g.get("segmentos") %}<div class="grafico" style="width:calc(50% - 3mm)"><div class="titulo-g">{{ segmentos[0].titulo }} (USD mn)</div>{{ g.segmentos }}</div>{% endif %}
  {% if concentracion %}
  <div style="break-inside: avoid">
  <h3>Concentración de clientes</h3>
  <table class="datos">
    <tr><th>Cliente (denominación de la empresa)</th><th>Base</th>{% for a in concentracion.anios %}<th>FY{{ a }}</th>{% endfor %}<th>Detalle declarado</th></tr>
    {% for f in concentracion.filas %}<tr><td>{{ f.cliente }}</td><td>{{ f.base }}</td>{% for v in f.valores %}<td>{{ v }}</td>{% endfor %}<td>{{ f.detalle }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Porcentajes que la empresa declara en el XBRL del 10-K (concentración de riesgo por cliente, ASC 275 y ASC 280), sobre la base indicada. «Detalle declarado»: segmento o región al que la empresa atribuye el porcentaje.</div>
  </div>
  {% endif %}
  {{ t["negocio.pipeline"] }}
  {% set comp = c.competencia %}
  <h3>Competencia</h3>
  {{ t["negocio.competencia"] }}
  {% if comp.texto and comp.texto.valida %}<div class="fuente">Apartado «Competition» del Item 1 del 10-K, traducido al español por IA ({{ comp.texto.modelo }}) y verificado por código (mismas cifras y nombres propios que el original); los nombres de competidores, productos y marcas se dejan en su idioma.{% if comp.texto.recortado %} Extracto: el apartado continúa en el 10-K.{% endif %}</div>{% elif comp.texto %}<div class="fuente">Texto original del Item 1 del 10-K.</div>{% endif %}
  {% if comp.cuotas %}
  <div style="break-inside: avoid">
  <table class="datos">
    <tr><th>Empresa</th><th>Cuota de ingresos del grupo (LTM)</th></tr>
    {% for tk, cuota in comp.cuotas|dictsort(by="value", reverse=True) %}<tr{% if tk == c.ticker %} class="total"{% endif %}><td>{{ c.empresa if tk == c.ticker else comp.nombres[tk] }} ({{ tk }})</td><td>{{ cuota|pct }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Ingresos LTM de la empresa y de los comparables del analista (mismo normalizador SEC), sobre su suma.</div>
  </div>
  {% endif %}
  {% if comp.roic_menos_wacc is not none or comp.estabilidad is not none %}<p>{% if comp.roic_menos_wacc is not none %}El ROIC ({{ comp.roic|pct }}) {% if comp.roic_menos_wacc >= 0 %}supera{% else %}queda por debajo de{% endif %} el WACC del escenario base ({{ comp.wacc|pct }}) en {{ (comp.roic_menos_wacc|abs * 100)|num(1) }} pp{% if comp.roic_mediana is not none %}; la mediana del ROIC de sus comparables es del {{ comp.roic_mediana|pct }}{% endif %}.{% endif %}{% if comp.estabilidad is not none %} La desviación típica de su margen operativo en los últimos cinco ejercicios es de {{ (comp.estabilidad * 100)|num(1) }} pp{% if comp.estabilidad_mediana is not none %}, frente a {{ (comp.estabilidad_mediana * 100)|num(1) }} pp de mediana en sus comparables{% endif %}.{% endif %}</p>{% endif %}
  <h3>Posicionamiento competitivo</h3>
  {{ t["negocio.posicionamiento"] }}
  <h3>Industria y mercado</h3>
  {{ t["industria.mercado"] }}
  <div style="break-inside: avoid"><h2><span class="num">03</span>Gobierno corporativo</h2>
  {{ t["gobierno.consejo"] }}</div>
  {% if insiders %}{% set ins = c.insiders %}{% set a = ins.actividad %}
  <h3>Accionistas de más del 5 %</h3>
  {% if insiders.proxy %}<table class="datos">
    <tr><th>Accionista</th><th>Acciones (mn)</th><th>% del capital</th></tr>
    {% for f in insiders.proxy %}<tr><td>{{ f.nombre }}</td><td>{{ f.acciones }}</td><td>{{ f.porcentaje }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Proxy DEF 14A del {{ ins.accionistas.proxy_fecha.strftime("%d/%m/%Y") }} (Item 403), tal como lo declara la empresa.</div>{% endif %}
  {% if insiders.declaraciones %}<table class="datos">
    <tr><th>Declaraciones 13D/13G posteriores al proxy</th><th>% declarado</th><th>Fecha del hecho</th><th>Formulario</th></tr>
    {% for f in insiders.declaraciones %}<tr><td>{{ f.nombre }}</td><td>{{ f.porcentaje }}</td><td>{{ f.fecha }}</td><td>{{ f.formulario }}</td></tr>{% endfor %}
  </table>{% endif %}
  {% set p = ins.participaciones %}{% if p %}
  <p class="fuente" style="margin-top:2mm"><strong>Fuente externa, no auditada (yfinance, consulta del {{ p.consulta }}):</strong> insiders {{ p.insiders|pct }} del capital; instituciones {{ p.instituciones|pct }}{% if p.numero_instituciones %} ({{ p.numero_instituciones|num(0) }} instituciones){% endif %}.{% if p.principales %} Principales tenedores institucionales: {% for h in p.principales %}{{ h.nombre }} {{ h.porcentaje|pct }}{{ "; " if not loop.last else "" }}{% endfor %} (13F a {{ p.principales[0].fecha }}).{% endif %}
  {% if not insiders.proxy and not insiders.declaraciones %}<p class="fuente">Sin accionistas de más del 5 % declarados en el último proxy ni en 13D/13G de los últimos 12 meses.</p>{% endif %}
  <h3>Compras y ventas de insiders en mercado (12 meses)</h3>
  <p>Entre el {{ ins.desde.strftime("%d/%m/%Y") }} y el {{ ins.hasta.strftime("%d/%m/%Y") }} ({{ ins.formularios }} Form 4), {% if a.compras or a.ventas %}{{ a.insiders }} insiders hicieron {{ a.compras }} compras ({{ (a.importe_compras / 1e6)|num(1) }} USD Mn) y {{ a.ventas }} ventas ({{ (a.importe_ventas / 1e6)|num(1) }} USD Mn) en mercado: saldo neto de {{ (a.saldo / 1e6)|num(1) }} USD Mn.{% if a.ventas_con_plan %} {{ a.ventas_con_plan }} de las ventas ({{ (a.importe_ventas_con_plan / 1e6)|num(1) }} USD Mn) se hicieron con un plan 10b5-1, programadas de antemano.{% endif %}{% if a.agrupadas %} Hubo compras agrupadas: {{ a.agrupadas.compradores|length }} insiders compraron entre el {{ a.agrupadas.desde.strftime("%d/%m/%Y") }} y el {{ a.agrupadas.hasta.strftime("%d/%m/%Y") }}.{% endif %}{% else %}no hubo compras ni ventas de insiders en mercado.{% endif %}{% if ins.retribucion.operaciones or ins.retenciones.operaciones %} Aparte, y sin ser compras ni ventas en mercado, recibieron {{ ins.retribucion.acciones|num(0) }} acciones como retribución ({{ ins.retribucion.operaciones }} concesiones o ejercicios) y entregaron {{ ins.retenciones.acciones|num(0) }} para pagar impuestos.{% endif %}</p>
  {% if insiders.operaciones %}<table class="datos compacta">
    <tr><th>Fecha</th><th>Insider</th><th>Cargo</th><th>Operación</th><th>Acciones</th><th>Precio (USD)</th><th>Importe (USD mn)</th><th>Plan 10b5-1</th></tr>
    {% for o in insiders.operaciones %}<tr><td>{{ o.fecha }}</td><td>{{ o.nombre }}</td><td>{{ o.cargo|truncate(28, True, "…") }}</td><td>{{ o.tipo }}</td><td>{{ o.acciones }}</td><td>{{ o.precio }}</td><td>{{ o.importe }}</td><td>{{ o.plan }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Form 4 de la SEC: solo las operaciones en mercado (códigos P y S); las {{ insiders.operaciones|length }} de mayor importe. Cargo tal como figura en el formulario.</div>{% endif %}
</p>{% endif %}
  {% endif %}
</section>

<!-- ============ 3. ANÁLISIS FINANCIERO ============ -->
<section class="salto">
  <h2><span class="num">04</span>Análisis financiero</h2>
  {{ t["financiero.comentario"] }}
  <div class="graficos">
    <div class="grafico"><div class="titulo-g">Ingresos (USD mn) y margen EBITDA</div>{{ g.ingresos }}</div>
    <div class="grafico"><div class="titulo-g">Beneficio neto y flujo de caja libre (USD mn)</div>{{ g.fcf }}</div>
    <div class="grafico"><div class="titulo-g">Rentabilidad sobre el capital</div>{{ g.rentabilidad }}</div>
    <div class="grafico"><div class="titulo-g">Márgenes</div>{{ g.margenes }}</div>
  </div>
  {% if g.get("cascada") %}
  <div class="grafico" style="width:100%; margin-top:3mm"><div class="titulo-g">Del EBITDA al flujo de caja libre (FY{{ c.filing.ejercicio }}, USD mn)</div>{{ g.cascada }}</div>
  <div class="fuente">Partidas declaradas en el estado de flujos de efectivo; la remuneración en acciones se suma porque no es caja y se resta al final como coste. «Circulante y otros» es la diferencia hasta el flujo operativo declarado.</div>
  {% endif %}
  {% if g.get("vencimientos") %}
  <div class="grafico" style="width:calc(50% - 3mm); margin-top:3mm"><div class="titulo-g">Vencimientos de la deuda (principal, USD mn)</div>{{ g.vencimientos }}</div>
  <div class="fuente">Vencimientos de principal declarados en el 10-K; suman {{ (c.vencimientos.suma / 1e6)|num(0) }} USD mn, en línea con la deuda declarada ({{ (c.vencimientos.valor_referencia / 1e6)|num(0) }} USD mn). Un año sin barra no tiene dato declarado.</div>
  {% endif %}

  {% for tabla in estados %}
  <h3>{{ tabla.titulo }}{% if tabla.titulo != "Ratios" %} (USD mn){% endif %}</h3>
  <table class="datos">
    <tr><th></th>{% for a in c.ejercicios %}<th>FY{{ a }}</th>{% endfor %}<th>{{ etiqueta_ltm }}</th></tr>
    {% for fila in tabla.filas %}<tr class="{{ fila.clase }}"><td>{{ fila.nombre }}</td>{% for v in fila.valores %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  {% endfor %}
  {% if trimestres %}
  <div style="break-inside: avoid">
  <h3>Últimos {{ trimestres.cabecera|length }} trimestres (USD mn)</h3>
  <table class="datos">
    <tr><th></th>{% for a in trimestres.cabecera %}<th>{{ a }}</th>{% endfor %}</tr>
    {% for fila in trimestres.filas %}<tr class="{{ fila.clase }}"><td>{{ fila.nombre }}</td>{% for v in fila.valores %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  <div class="fuente">Trimestres de los 10-Q y del 10-K (el cuarto trimestre = anual − nueve meses). BPA diluido declarado; el del cuarto trimestre, derivado (edgartools). Variación frente al mismo trimestre del año anterior.</div>
  </div>
  {% endif %}

  {% if c.notas %}<div class="fuente"><strong>Notas a los ratios ({{ etiqueta_ltm }}).</strong> {% for ratio, nota in c.notas %}{{ ratio }}: {{ nota }} {% endfor %}</div>{% endif %}
  {% if publicaciones %}
  <div style="break-inside: avoid">
  <h3>Publicaciones de resultados y reacción de la cotización</h3>
  <table class="datos">
    <tr><th>Fecha (8-K)</th><th>Trimestre</th><th>Ingresos (USD mn)</th><th>Var. interanual</th><th>BPA diluido (USD)</th><th>Primera sesión</th><th>Reacción 5 sesiones</th></tr>
    {% for p in publicaciones %}<tr><td>{{ p.fecha }}</td><td>{{ p.trimestre }}</td><td>{{ p.ingresos }}</td><td>{{ p.variacion }}</td><td>{{ p.bpa }}</td><td>{{ p.sesion }}</td><td>{{ p.reaccion }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">8-K con ítem 2.02 (resultados). Primera sesión: la del día si se presentó antes del cierre de Nueva York (16:00) y la siguiente si fue después. Reacción: cierre de la quinta sesión frente al cierre previo, sin comparar con índices.</div>
  </div>
  {% endif %}
</section>

<!-- ============ 4. VALORACIÓN ============ -->
<section class="salto">
  <h2><span class="num">05</span>Valoración</h2>
  {{ t["valoracion.comentario"] }}
  {% for aviso in c.avisos_valoracion %}<p class="fuente">{{ aviso }}</p>{% endfor %}
  {% if c.metodos %}
  <div style="break-inside: avoid">
  <h3>Derivación del precio objetivo</h3>
  <table class="datos">
    <tr><th>Método</th><th>Valor (USD)</th><th>Rango (USD)</th><th style="text-align:left">Supuesto clave</th><th>Peso</th></tr>
    {% for m in c.metodos %}<tr><td>{{ m.nombre }}</td><td>{{ m.valor|num(2) }}</td><td>{% if m.bajo is not none and m.alto is not none %}{{ m.bajo|num(0) }} – {{ m.alto|num(0) }}{% else %}—{% endif %}</td><td style="text-align:left">{{ m.supuesto }}</td><td>{{ m.peso_efectivo|pct(0) }}</td></tr>{% endfor %}
    <tr class="total"><td>Precio objetivo del modelo</td><td>{{ c.precio_modelo|num(2) }}</td><td></td><td></td><td>{{ "100 %" if c.precio_modelo is not none else "—" }}</td></tr>
  </table>
  {% if g.get("rangos") %}<div class="grafico" style="width:100%"><div class="titulo-g">Rangos de valoración por método frente a la cotización (USD por acción)</div>{{ g.rangos }}</div>{% endif %}
  <div class="fuente">Peso efectivo: los pesos del analista, repartidos entre los métodos con valor. Rangos: escenarios pesimista-optimista del DCF; cuartiles de los comparables y de la propia historia; mínimo y máximo de 12 meses de la cotización.</div>
  </div>
  {% endif %}

  {% if c.dcf %}
  <div class="rejilla">
    <div class="principal">
      <h3>Escenarios del DCF (USD por acción)</h3>
      <table class="datos">
        <tr><th></th><th>Probabilidad</th><th>Crec. ventas (media)</th><th>Margen EBITDA (media)</th><th>Valor por acción</th><th>Potencial</th></tr>
        {% for nombre, est_e, p in c.escenarios.items() %}{% set r = c.dcf_escenarios.resultados[nombre] %}<tr{% if nombre == "Base" %} class="seccion-base"{% endif %}><td>{{ nombre }}</td><td>{{ p|pct(0) }}</td><td>{{ (est_e.crecimiento_ventas|sum / est_e.crecimiento_ventas|length)|pct }}</td><td>{{ (est_e.margen_ebitda|sum / est_e.margen_ebitda|length)|pct }}</td><td>{{ r.valor_por_accion|num(2) }}</td><td>{{ (r.valor_por_accion / c.cotizacion.precio - 1)|var }}</td></tr>{% endfor %}
        <tr class="total"><td>Valor ponderado</td><td>100 %</td><td></td><td></td><td>{{ c.valor_dcf|num(2) }}</td><td>{{ c.potencial_dcf|var }}</td></tr>
      </table>
      <div class="fuente">{% for nombre, est_e, p in c.escenarios.items() if nombre != "Base" %}<strong>{{ nombre }}:</strong> {{ c.escenarios.desencadenantes.get(nombre) or ("ventas " ~ ((est_e.crecimiento_ventas|sum / est_e.crecimiento_ventas|length)|var) ~ " anual y margen EBITDA del " ~ ((est_e.margen_ebitda|sum / est_e.margen_ebitda|length)|pct)) }}{{ ". " if not loop.last else "." }}{% endfor %}</div>
      <h3>DCF del escenario base (USD mn)</h3>
      <table class="datos">
        <tr><th></th>{% for a in anios_est %}<th class="e">{{ a }}</th>{% endfor %}<th class="e">Convergencia ({{ c.estimaciones.anios_convergencia }} a)</th></tr>
        {% set n = c.dcf.explicitos %}
        <tr><td>Ingresos</td>{% for v in c.dcf.ingresos[:n] %}<td class="e">{{ (v/1e6)|num(0) }}</td>{% endfor %}<td class="e">{{ (c.dcf.ingresos[-1]/1e6)|num(0) }}</td></tr>
        <tr><td>EBITDA</td>{% for v in c.dcf.ebitda[:n] %}<td class="e">{{ (v/1e6)|num(0) }}</td>{% endfor %}<td class="e">{{ (c.dcf.ebitda[-1]/1e6)|num(0) }}</td></tr>
        <tr><td>FCFF</td>{% for v in c.dcf.flujos[:n] %}<td class="e">{{ (v/1e6)|num(0) }}</td>{% endfor %}<td class="e">{{ (c.dcf.flujos[n:]|sum/1e6)|num(0) }}</td></tr>
      </table>
      <div class="fuente">Convergencia: último año (ingresos y EBITDA) y suma de los FCFF. El EBIT ya resta la remuneración en acciones como gasto: el FCFF no la vuelve a sumar.</div>
      <table class="datos">
        <tr><td>Valor actual de los flujos (10 años)</td><td>{{ (c.dcf.va_flujos/1e6)|num(0) }}</td></tr>
        <tr><td>Valor actual del valor terminal ({{ (c.dcf.va_terminal / c.dcf.ev)|pct(0) }} del EV)</td><td>{{ (c.dcf.va_terminal/1e6)|num(0) }}</td></tr>
        <tr class="total"><td>Valor de empresa (EV)</td><td>{{ (c.dcf.ev/1e6)|num(0) }}</td></tr>
        <tr><td>− Deuda financiera neta ({{ etiqueta_ltm }})</td><td>{{ ((fl.dfn or 0)/1e6)|num(0) }}</td></tr>
        {% for nombre, valor in c.componentes_ev.items() if valor %}<tr><td>− {{ nombre }}</td><td>{{ (valor/1e6)|num(0) }}</td></tr>{% endfor %}
        {% if c.datos_dcf.minoritarios %}<tr><td>− Intereses minoritarios</td><td>{{ (c.datos_dcf.minoritarios/1e6)|num(0) }}</td></tr>{% endif %}
        <tr class="total"><td>Valor del patrimonio</td><td>{{ (c.dcf.equity/1e6)|num(0) }}</td></tr>
        <tr><td>Acciones (mn)</td><td>{{ (c.mercado.acciones/1e6)|num(0) }}</td></tr>
        <tr class="total"><td>Valor por acción, escenario base (USD)</td><td>{{ c.dcf.valor_por_accion|num(2) }}</td></tr>
      </table>
      <h3>Sensibilidad del valor por acción (USD): WACC × g</h3>
      <table class="datos">
        <tr><th>WACC \ g</th>{% for g_ in sens_g %}<th>{{ g_|pct(1) }}</th>{% endfor %}</tr>
        {% for w in sens_w %}<tr><td>{{ w|pct(1) }}</td>{% for g_ in sens_g %}<td>{{ c.dcf.sensibilidad.get((w, g_))|num(1) }}</td>{% endfor %}</tr>{% endfor %}
      </table>
      <h3>Sensibilidad: crecimiento de ventas × margen EBITDA</h3>
      <table class="datos">
        <tr><th>Δ crecimiento \ Δ margen</th>{% for m in sens_m %}<th>{{ "%+.0f"|format(m * 100)|replace("-", "−") }} pp</th>{% endfor %}</tr>
        {% for x in sens_c %}<tr><td>{{ "%+.0f"|format(x * 100)|replace("-", "−") }} pp</td>{% for m in sens_m %}<td>{{ c.dcf.sensibilidad_operativa.get((x, m))|num(1) }}</td>{% endfor %}</tr>{% endfor %}
      </table>
    </div>
    <div class="lateral">
      <h3>Supuestos del escenario base (editables)</h3>
      <table class="datos lateral-tabla">
        {% set cv = c.estimaciones.crecimiento_ventas %}{% set me = c.estimaciones.margen_ebitda %}
        <tr><td>Crecimiento de ventas</td><td>{% if cv|unique|list|length == 1 %}{{ cv[0]|pct }} anual{% else %}{{ cv|map("pct")|join(" · ") }}{% endif %}</td></tr>
        <tr><td>Margen EBITDA</td><td>{% if me|unique|list|length == 1 %}{{ me[0]|pct }}{% else %}{{ me|map("pct")|join(" · ") }}{% endif %}</td></tr>
        <tr><td>Años explícitos + convergencia</td><td>{{ c.estimaciones.crecimiento_ventas|length }} + {{ c.estimaciones.anios_convergencia }}</td></tr>
        <tr><td>D&amp;A / ventas</td><td>{{ c.estimaciones.da_sobre_ventas|pct }}</td></tr>
        <tr><td>Capex / ventas</td><td>{{ c.estimaciones.capex_sobre_ventas|pct }}</td></tr>
        <tr><td>Tasa fiscal</td><td>{{ c.estimaciones.tasa_fiscal|pct }}</td></tr>
        <tr><td>Tipo libre de riesgo</td><td>{{ c.estimaciones.rf|pct }}</td></tr>
        <tr><td>Prima de riesgo</td><td>{{ c.estimaciones.erp|pct }}</td></tr>
        <tr><td>Beta</td><td>{{ c.estimaciones.beta|num(2) }}</td></tr>
        <tr><td>Coste del capital (Ke)</td><td>{{ c.dcf.ke|pct }}</td></tr>
        <tr><td>Coste de la deuda (antes de imp.)</td><td>{{ c.estimaciones.coste_deuda|pct }}</td></tr>
        <tr class="total"><td>WACC</td><td>{{ c.dcf.wacc|pct }}</td></tr>
        <tr><td>Crecimiento a perpetuidad (g)</td><td>{{ c.estimaciones.g|pct }}</td></tr>
        <tr><td>Resultado financiero / ventas</td><td>{{ c.estimaciones.resultado_financiero_sobre_ventas|pct }}</td></tr>
        <tr><td>Variación anual de acciones</td><td>{{ c.estimaciones.variacion_acciones|pct }}</td></tr>
        <tr><td>Pay-out</td><td>{{ c.estimaciones.payout|pct }}</td></tr>
        <tr><td>Remuneración en acciones / ventas</td><td>{{ c.estimaciones.sbc_sobre_ventas|pct }}</td></tr>
        <tr><td>Recompras / FCF tras SBC</td><td>{{ c.estimaciones.recompras_sobre_fcf|pct }}</td></tr>
        <tr><td>Pesos del precio objetivo</td><td>{% for nombre, peso in c.estimaciones.pesos.items() if peso %}{{ nombre }} {{ peso|pct(0) }}{{ " · " if not loop.last }}{% endfor %}</td></tr>
      </table>
      <div class="fuente">Por defecto: medias de los tres últimos ejercicios. Tipo libre de riesgo: {{ c.rf.fuente if c.rf else "valor por defecto" }}{% if c.rf and c.rf.fecha %} a {{ c.rf.fecha }}{% endif %}. Escenarios: base ∓ 1 desviación típica histórica del crecimiento y del margen.</div>
      <h3>DCF inverso (escenario base)</h3>
      <table class="datos lateral-tabla">
        <tr><td>Crecimiento implícito de ventas</td><td>{% if c.inverso.crecimiento and c.inverso.crecimiento.codigo == "resuelto" %}{{ c.inverso.crecimiento.valor|pct }}{% elif c.inverso.crecimiento and c.inverso.crecimiento.codigo == "por_encima" %}&gt; {{ c.inverso.crecimiento.intervalo[1]|pct(0) }}{% else %}n.d.{% endif %}</td></tr>
        <tr><td>Rentabilidad anual implícita</td><td>{% if c.inverso.wacc and c.inverso.wacc.codigo == "resuelto" %}{{ c.inverso.wacc.valor|pct }}{% else %}n.d.{% endif %}</td></tr>
      </table>
      <div class="fuente">Crecimiento constante en los años explícitos (resto de supuestos iguales) y tasa de descuento que igualan el valor a la cotización.</div>
    </div>
  </div>
  {% endif %}

  <h3>Proyección hasta el BPA (USD mn)</h3>
  <table class="datos">
    <tr><th></th><th>{{ etiqueta_ltm }}</th>{% for a in anios_est %}<th class="e">{{ a }}</th>{% endfor %}</tr>
    {% for fila in proyeccion %}<tr class="{{ fila.clase }}"><td>{{ fila.nombre }}</td><td>{{ fila.ltm }}</td>{% for v in fila.valores %}<td class="e">{{ v }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  <div class="fuente">Las mismas ventas, EBITDA y EBIT que el DCF del escenario base. Periodos de doce meses a partir del LTM.</div>

  <div style="break-inside: avoid">
  <h3>Flujo de caja proyectado (USD mn)</h3>
  <table class="datos">
    <tr><th></th><th>{{ etiqueta_ltm }}</th>{% for a in anios_est %}<th class="e">{{ a }}</th>{% endfor %}</tr>
    {% for fila in flujo_balance.flujo %}<tr class="{{ fila.clase }}"><td>{{ fila.nombre }}</td><td>{{ fila.ltm }}</td>{% for v in fila.valores %}<td class="e">{{ v }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  </div>
  {% if flujo_balance.balance %}
  <div style="break-inside: avoid">
  <h3>Balance resumido proyectado (USD mn)</h3>
  <table class="datos">
    <tr><th></th><th>{{ etiqueta_ltm }}</th>{% for a in anios_est %}<th class="e">{{ a }}</th>{% endfor %}</tr>
    {% for fila in flujo_balance.balance %}<tr class="{{ fila.clase }}"><td>{{ fila.nombre }}</td><td>{{ fila.ltm }}</td>{% for v in fila.valores %}<td class="e">{{ v }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  <div class="fuente">Proyección con los supuestos del escenario base y el balance del LTM: la deuda se mantiene; la caja recoge el flujo libre menos dividendos y recompras; el patrimonio, el beneficio y la remuneración en acciones menos dividendos y recompras. Caja + activos operativos netos = deuda + patrimonio (+ minoritarios) cada año. Una caja negativa indica necesidad de financiación (ampliación de capital o deuda).</div>
  </div>
  {% endif %}
  {% if g.get("flujo") %}<div class="graficos">
    <div class="grafico"><div class="titulo-g">FCF tras SBC y retribución al accionista (USD mn)</div>{{ g.flujo }}</div>
    {% if g.get("balance") %}<div class="grafico"><div class="titulo-g">Deuda financiera neta y patrimonio neto (USD mn)</div>{{ g.balance }}</div>{% endif %}
  </div>
  <div class="fuente">Ejercicios fiscales, LTM ({{ etiqueta_ltm }}) y periodos estimados de doce meses (e, mismo mes de cierre que el LTM) a la derecha de la línea discontinua; cifras del propio informe.</div>{% endif %}


  <div style="break-inside: avoid">
  <h3>Comparables ({{ etiqueta_ltm }} de cada empresa)</h3>
  {% if not c.comparables_del_analista %}<p class="aviso-revisar"><span class="revisar">Revisar</span> <strong>El analista debe introducir su lista de comparables para que la valoración por múltiplos se genere correctamente.</strong> La tabla muestra una propuesta automática orientativa ({{ c.comparables_criterio }}) que <strong>no entra en el precio objetivo</strong>: el código SIC agrupa mal a muchas empresas.</p>{% else %}<p class="fuente">Lista de comparables del analista.</p>{% endif %}
  {% if comparables %}
  <table class="datos compacta">
    <tr><th>Empresa</th><th>Cap. (USD bn)</th><th>Crec. ventas LTM</th><th>TACC ventas 3a</th><th>TACC BPA 3a</th><th>Margen EBITDA</th>{% for _, nombre, _, _, _ in multiplos_def %}<th>{{ nombre }}</th>{% endfor %}</tr>
    {% for p in comparables %}<tr><td>{{ p.nombre|truncate(24, True, "…") }} ({{ p.ticker }})</td><td>{{ p.capitalizacion }}</td><td>{{ p.crecimiento }}</td><td>{{ p.tacc_ventas }}</td><td>{{ p.tacc_bpa }}</td><td>{{ p.margen }}</td>{% for v in p.multiplos %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}
    <tr class="total"><td>Mediana (n.º)</td><td></td><td></td><td></td><td></td><td></td>{% for clave, _, _, _, _ in multiplos_def %}<td>{{ c.comparables_stats[clave].mediana|num(1) }}x ({{ c.comparables_stats[clave].n }})</td>{% endfor %}</tr>
    <tr><td>{{ c.empresa|truncate(24, True, "…") }} ({{ c.ticker }})</td><td>{{ (c.multiplos.capitalizacion/1e9)|num(1) }}</td><td>{{ fl.crecimiento_ingresos|pct }}</td><td>—</td><td>—</td><td>{{ fl.margen_ebitda|pct }}</td>{% for clave, _, _, _, _ in multiplos_def %}<td>{{ c.multiplos[clave]|num(1) }}x</td>{% endfor %}</tr>
    <tr class="total"><td>Valor implícito por acción (USD)</td><td></td><td></td><td></td><td></td><td></td>{% for clave, _, _, _, _ in multiplos_def %}<td>{{ c.comparables_implicitos[clave]|num(2) }}</td>{% endfor %}</tr>
  </table>
  <div class="fuente">Múltiplos LTM con el mismo normalizador SEC. La mediana excluye valores negativos y no significativos (n.s.: PER &gt; 75x, EV/EBITDA o P/FCF por encima del límite) y exige al menos 3 comparables. Valor por múltiplos (media de EV/EBITDA y PER): {% if c.comparables_del_analista %}{{ c.valor_multiplos|num(2) }} USD{% else %}{{ c.valor_multiplos_orientativo|num(2) }} USD (orientativo, fuera del precio objetivo){% endif %}.</div>
  {% else %}<p><span class="pendiente">no hay comparables cotizados con datos LTM completos: añade la lista</span></p>{% endif %}
  </div>

  {% if historicos %}
  <div style="break-inside: avoid">
  <h3>Múltiplos frente a su propia historia</h3>
  <table class="datos">
    <tr><th>Múltiplo</th><th>Actual</th><th>Mediana</th><th>P25</th><th>P75</th><th>P90</th><th>Percentil actual</th><th>Valor a la mediana (USD)</th></tr>
    {% for h in historicos %}<tr><td>{{ h.nombre }}</td><td>{{ h.actual }}x</td><td>{{ h.mediana }}x</td><td>{{ h.p25 }}x</td><td>{{ h.p75 }}x</td><td>{{ h.p90 }}x</td><td>{{ h.percentil }}</td><td>{{ h.implicito }}</td></tr>{% endfor %}
  </table>
  {% if g.get("historico") %}<div class="grafico" style="width:calc(50% - 3mm)"><div class="titulo-g">{{ g.historico_nombre }} de los últimos años: mediana y cuartiles</div>{{ g.historico }}</div>{% endif %}
  <div class="fuente">Precio semanal sin ajustar por dividendos; cifras de cada ejercicio desde el día en que se presentó su 10-K (sin sesgo de anticipación) y acciones de cada ejercicio. Actual: cotización de hoy sobre el último ejercicio presentado (la misma base que la historia; la portada usa el LTM). Valor a la mediana: el múltiplo mediano aplicado al LTM.</div>
  </div>
  {% endif %}
  {% if c.sotp %}
  <div style="break-inside: avoid">
  <h3>Suma de partes (FY{{ c.filing.ejercicio }})</h3>
  <table class="datos">
    <tr><th>Segmento</th><th>Resultado operativo (USD mn)</th><th>EV / EBIT</th><th>EV (USD mn)</th></tr>
    {% for fila in c.sotp.filas %}<tr><td>{{ fila.nombre }}</td><td>{{ (fila.resultado/1e6)|num(0) }}</td><td>{{ fila.multiplo|num(1) }}x</td><td>{{ (fila.ev/1e6)|num(0) }}</td></tr>{% endfor %}
    <tr class="total"><td>Valor de empresa</td><td></td><td></td><td>{{ (c.sotp.ev/1e6)|num(0) }}</td></tr>
    <tr><td>− Deuda neta ajustada y minoritarios</td><td></td><td></td><td>{{ ((c.sotp.ev - c.sotp.equity)/1e6)|num(0) }}</td></tr>
    <tr class="total"><td>Valor por acción (USD)</td><td></td><td></td><td>{{ c.sotp.por_accion|num(2) }}</td></tr>
  </table>
  <div class="fuente">Resultado de cada segmento declarado (ASC 280) por su múltiplo EV/EBIT (el del analista o la mediana de sus comparables). Los costes no asignados (EBIT consolidado − suma de segmentos) se valoran al mismo múltiplo.</div>
  </div>
  {% elif c.segmentos.get("negocio") and c.segmentos.negocio.resultado_operativo %}<p class="fuente">Suma de partes: necesita la lista de comparables del analista (mediana EV/EBIT) o un múltiplo por segmento.</p>{% endif %}

  {% if c.cambios %}
  <div style="break-inside: avoid">
  <h3>Cambios frente al informe anterior ({{ c.cambios.fecha_anterior }})</h3>
  {% if c.cambios.cambios %}<table class="datos">
    <tr><th>Concepto</th><th>Anterior</th><th>Actual</th></tr>
    {% for x in c.cambios.cambios %}<tr><td>{{ x.campo }}</td><td>{% if x.antes is number %}{{ ((x.antes/1e6) if (x.antes|abs) > 1e6 else x.antes)|num(2) }}{% else %}{{ x.antes or "—" }}{% endif %}</td><td>{% if x.ahora is number %}{{ ((x.ahora/1e6) if (x.ahora|abs) > 1e6 else x.ahora)|num(2) }}{% else %}{{ x.ahora or "—" }}{% endif %}</td></tr>{% endfor %}
  </table>{% endif %}
  {% if c.cambios.atribucion %}<table class="datos">
    <tr><th>Qué explica el cambio del valor DCF (escenario base)</th><th>USD por acción</th></tr>
    {% for p in c.cambios.atribucion.pasos %}<tr><td>{{ p.grupo }}</td><td>{{ "%+.2f"|format(p.impacto)|replace(".", ",")|replace("-", "−") }}</td></tr>{% endfor %}
    <tr class="total"><td>Cambio total</td><td>{{ "%+.2f"|format(c.cambios.atribucion.total)|replace(".", ",")|replace("-", "−") }}</td></tr>
  </table>
  <div class="fuente">Atribución secuencial (suma exactamente el cambio total): primero los datos de partida y después cada grupo de supuestos, en este orden. El precio objetivo puede cambiar además por los métodos que entran en él (p. ej., la lista de comparables del analista). Importes en USD mn cuando superan el millón.</div>{% endif %}
  </div>
  {% endif %}

</section>

<!-- ============ 6. RIESGOS ============ -->
<section>
  <h2><span class="num">06</span>Análisis de riesgos</h2>
  {% set cat = c.catalizadores %}
  <h3>Catalizadores según la dirección</h3>
  {% if cat.ia and cat.ia.lista %}<ul>{% for s in cat.ia.lista %}<li><strong>{{ s.resumen }}</strong><br><span class="cita">«{{ s.cita }}»</span></li>{% endfor %}</ul>
  <div class="fuente">{% if cat.ia.modelo %}Selección y resumen: {{ cat.ia.modelo }}, entre {{ cat.ia.candidatos }} frases prospectivas literales del MD&amp;A (Item 7). Cada cita se ha verificado en el texto del 10-K.{% else %}Catalizadores del analista.{% endif %}</div>
  {% else %}<p><span class="pendiente">catalizadores de crecimiento según el MD&amp;A (Item 7)</span></p>{% endif %}
  {% if calendario %}
  <div style="break-inside: avoid">
  <h3>Calendario</h3>
  {% if not cat.del_analista %}<p class="aviso-revisar"><span class="revisar">Revisar</span> Borrador del SaaS con fechas estimadas a partir de los filings de la SEC (todas posteriores a la fecha de emisión): el analista debe confirmarlo o introducir el suyo.</p>{% endif %}
  <table class="datos">
    <tr><th>Evento</th><th>Fecha</th><th>Base</th></tr>
    {% for e in calendario %}<tr><td>{{ e.evento }}</td><td>{{ e.fecha }}</td><td style="text-align:left">{{ e.base }}</td></tr>{% endfor %}
  </table>
  </div>
  {% endif %}
  {% if cat.hechos %}
  <div style="break-inside: avoid">
  <h3>Hechos relevantes de los últimos 12 meses (8-K)</h3>
  <table class="datos">
    <tr><th>Fecha</th><th>Hecho comunicado</th><th>Filing</th></tr>
    {% for h in cat.hechos %}<tr><td>{{ h.fecha.strftime("%d/%m/%Y") }}</td><td style="text-align:left">{{ h.hechos|join("; ") }}</td><td>{{ h.accession }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Ítems de cada 8-K según las instrucciones de la SEC; los de resultados (2.02) están en el apartado 04 y los anexos (9.01) no se listan.</div>
  </div>
  {% endif %}
  <h3>Riesgos principales</h3>
  {% if c.riesgos %}<ul>{% for r in c.riesgos %}<li><strong>{{ r.resumen }}</strong><br><span class="cita">«{{ r.cita }}»</span></li>{% endfor %}</ul>
  <div class="fuente">Selección y resumen: {{ c.riesgos[0].modelo }}, entre los títulos literales del Item 1A. Cada cita se ha verificado en el texto del 10-K.</div>
  {% else %}<p><span class="pendiente">resume los riesgos principales del Item 1A</span></p>{% endif %}
  {% if c.riesgos_cambios %}{% set rc = c.riesgos_cambios %}
  <h3>Cambios frente al informe anual anterior</h3>
  <p>Factores nuevos o reformulados: {{ rc.nuevos|length }} · eliminados: {{ rc.eliminados|length }} · modificados: {{ rc.modificados|length }} · sin cambios: {{ rc.sin_cambios }}.</p>
  {% if rc.nuevos %}<p><strong>Nuevos o reformulados:</strong></p><ul>{% for r in rc.nuevos %}<li>{{ r.titulo }}{% if r.posible_origen %} <span class="fuente">(posible reformulación de: «{{ r.posible_origen }}»)</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
  {% if rc.eliminados %}<p><strong>Eliminados:</strong></p><ul>{% for r in rc.eliminados %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
  <div class="fuente">Comparación por similitud de texto de los títulos del Item 1A (sin IA). Las reformulaciones las confirma el analista.</div>
  {% endif %}
  {% if c.puntuaciones %}
  <h3>Puntuaciones de riesgo contable (FY{{ c.filing.ejercicio }})</h3>
  <table class="datos">
    <tr><th>Puntuación</th><th>Valor</th><th style="text-align:left">Lectura</th><th style="text-align:left">Modelo</th></tr>
    {% for p in c.puntuaciones %}<tr><td>{{ p.nombre }}</td><td>{% if p.nombre == "Piotroski F" and p.valor is not none %}{{ p.valor|num(0) }} / 9{% elif p.valor is not none %}{{ "%.2f"|format(p.valor)|replace(".", ",")|replace("-", "−") }}{% else %}n.d.{% endif %}</td><td style="text-align:left">{{ p.lectura }}{% if p.faltan and p.valor is none %} (faltan: {{ p.faltan|join(", ") }}){% endif %}</td><td style="text-align:left">{{ p.modelo }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Altman Z (insolvencia), Beneish M (calidad del beneficio) y Piotroski F (solidez financiera), con las partidas del normalizador SEC. Definiciones en el anexo B.</div>
  <h3>Alarmas de la SEC (5 años)</h3>
  {% if c.alarmas %}<table class="datos">
    <tr><th>Alarma</th><th>Fecha</th><th>Detalle (cita literal del filing)</th><th>Filing</th></tr>
    {% for a in c.alarmas %}<tr><td>{{ a.tipo }}</td><td>{{ a.fecha.strftime("%d/%m/%Y") }}</td><td style="text-align:left">{{ a.detalle or "—" }}</td><td>{{ a.accession }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">8-K ítems 4.01 y 4.02, 10-K/A, 10-Q/A, NT 10-K y NT 10-Q; frases del último 10-K sobre control interno no eficaz o dudas sobre la continuidad (sin las hipotéticas de los factores de riesgo). Las valora el analista.</div>
  {% else %}<p>Sin alarmas: ningún cambio de auditor ni reexpresión (8-K 4.01 y 4.02), informe modificado o presentación tardía en 5 años, y el último 10-K no recoge control interno no eficaz ni dudas sobre la continuidad de la empresa.</p>{% endif %}
  {% endif %}
  {% if c.autonomia %}
  <h3>Autonomía de caja</h3>
  <table class="datos">
    <tr><td>Caja e inversiones a corto plazo (USD mn)</td><td>{{ (c.autonomia.liquidez/1e6)|num(0) }}</td></tr>
    <tr><td>Consumo de caja de los últimos doce meses (flujo operativo − capex, USD mn)</td><td>{{ (c.autonomia.consumo_anual/1e6)|num(0) }}</td></tr>
    <tr class="total"><td>Meses de caja al ritmo actual</td><td>{{ c.autonomia.meses|num(0) }}</td></tr>
    {% if c.autonomia.dilucion_anual is not none %}<tr><td>Variación anual de las acciones diluidas ({{ c.autonomia.anios_dilucion }} años)</td><td>{{ c.autonomia.dilucion_anual|var }}</td></tr>{% endif %}
  </table>
  <div class="fuente">Solo para empresas que consumen caja. No incluye financiación futura (ampliaciones, deuda o cobros por acuerdos).</div>
  {% endif %}
  <h3>Factores de riesgo declarados en el 10-K ({{ c.riesgos_lista|length }})</h3>
  <div class="dos-col" style="font-size:6.2pt"><ol>{% for r in c.riesgos_lista %}<li>{{ r }}</li>{% endfor %}</ol></div>


</section>

<!-- ============ ANEXO: TRAZABILIDAD Y CALIDAD ============ -->
<section class="salto">
  <h2><span class="num">A</span>Anexo: trazabilidad y control de calidad</h2>
  <div class="semaforo">Control de calidad de los datos: <strong>{{ c.calidad.nivel }}</strong>.
    {% if c.calidad.errores %}Errores: {{ c.calidad.errores|join("; ") }}.{% endif %}
    {% if c.calidad.avisos %}Avisos: {{ c.calidad.avisos|join("; ") }}.{% endif %}
    {% if not c.calidad.errores and not c.calidad.avisos %}Activo = pasivo + patrimonio, beneficio bruto y consistencia entre companyfacts y el 10-K verificados en todos los ejercicios.{% endif %}
  </div>
  <p>Plantilla aplicada: {{ c.cobertura.motivo }}.</p>
  <h3>Origen de cada partida (FY{{ c.filing.ejercicio }})</h3>
  <table class="datos">
    <tr><th>Partida</th><th style="text-align:left">Concepto XBRL (us-gaap)</th><th>Valor (USD mn)</th><th>Filing (accession)</th></tr>
    {% for fila in trazas %}<tr><td>{{ fila.nombre }}</td><td style="text-align:left">{{ fila.concepto }}</td><td>{{ fila.valor }}</td><td>{{ fila.origen }}</td></tr>{% endfor %}
  </table>
  <div class="fuente">Todas las cifras proceden de la SEC (EDGAR, companyfacts y XBRL del 10-K) y se calculan de forma determinista. La IA no genera ni modifica cifras.</div>
</section>

<section class="salto">
  <h2><span class="num">B</span>Anexo: metodología y fuentes</h2>
  <table class="datos">
    <tr><th>Ámbito</th><th style="text-align:left">Concepto</th><th style="text-align:left">Definición</th></tr>
    {% for grupo, termino, definicion in definiciones %}<tr><td>{{ grupo }}</td><td style="text-align:left; white-space:nowrap">{{ termino }}</td><td style="text-align:left">{{ definicion }}</td></tr>{% endfor %}
  </table>
  <h3>Sistema de recomendación</h3>
  <p>Horizonte de 12 meses. <strong>Comprar</strong>: potencial igual o superior a {{ (umbral_comprar * 100)|num(0) }} % frente a la cotización. <strong>Vender</strong>: potencial igual o inferior a {{ (umbral_vender * 100)|num(0) }} %. <strong>Mantener</strong>: entre ambos. El precio objetivo es la media ponderada de los métodos de valoración (tabla «Derivación del precio objetivo»); el analista puede fijar el suyo y confirma la recomendación antes de emitir.</p>
  {% if c.historial %}
  <h3>Historial de recomendación y precio objetivo</h3>
  <table class="datos">
    <tr><th>Fecha</th><th>Recomendación</th><th>Precio objetivo (USD)</th><th>Cotización entonces (USD)</th><th>Señal a hoy</th></tr>
    {% for h in c.historial %}<tr><td>{{ h.fecha }}</td><td>{{ h.recomendacion }}</td><td>{{ h.precio_objetivo|num(2) }}</td><td>{{ h.cotizacion|num(2) }}</td><td>{{ h.senal }}</td></tr>{% endfor %}
  </table>
  {% if g.get("historial") %}<div class="grafico" style="width:60%">{{ g.historial }}</div>{% endif %}
  <div class="fuente">Señal: acertada (a menos del 10 % del objetivo o más de la mitad del camino recorrido), fallida (10 % en contra tras 7 días o 12 meses sin acertar) o en curso.</div>
  {% endif %}
  <h3>Documentos y datos utilizados</h3>
  <table class="datos">
    <tr><td>Último 10-K (FY{{ c.filing.ejercicio }})</td><td>{{ c.filing.accession }} · {{ c.filing.fecha }}</td></tr>
    {% if c.filing.get("ultimo_periodico") %}<tr><td>Último informe periódico ({{ c.filing.get("ultimo_periodico_formulario") }}) · LTM</td><td>{{ c.filing.get("ultimo_periodico") }}{% if c.fecha_ltm %} · cierre {{ c.fecha_ltm }}{% endif %}</td></tr>{% endif %}
    {% if c.gobierno and c.gobierno.proxy_accession %}<tr><td>Proxy (DEF 14A)</td><td>{{ c.gobierno.proxy_accession }} · {{ c.gobierno.proxy_fecha }}</td></tr>{% endif %}
    <tr><td>Acciones en circulación</td><td>{{ c.acciones_origen or "portada del último filing" }}</td></tr>
    <tr><td>Cotización e índices</td><td>yfinance · {{ c.cotizacion.fecha }}</td></tr>
    <tr><td>Tipo libre de riesgo</td><td>{{ c.rf.fuente if c.rf else "valor por defecto" }}{% if c.rf and c.rf.fecha %} · {{ c.rf.fecha }}{% endif %}</td></tr>
    <tr><td>Comparables</td><td>{{ c.comparables_criterio or "sin comparables" }}</td></tr>
  </table>
</section>

<section class="salto legal">{{ legal }}</section>
</body>
</html>
